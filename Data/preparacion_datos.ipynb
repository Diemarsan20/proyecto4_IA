# Notebook: preparación_de_datos (script-style)
# Objetivo: limpiar, transformar, normalizar, reducir características (opcional),
#           seleccionar características con modelos/estadística, y generar splits
#           Train/Validation/Test guardando 6 CSVs (TrainX, TrainY, ValidationX, ValidationY, TestX, TestY).

"""

Notas de rendimiento:
- El script aplica estrategias de simplificación para columnas categóricas de alta cardinalidad
  (mantiene top-10 categorías y agrupa el resto como '_OTHER_') para evitar explosión dimensional.
- Para selección de características se usa SelectKBest (f_regression o f_classif) — rápido y determinista.
"""

import os
import pandas as pd
import numpy as np
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import OneHotEncoder, LabelEncoder, StandardScaler
from sklearn.decomposition import PCA
from sklearn.feature_selection import SelectKBest, f_regression, f_classif
from sklearn.model_selection import train_test_split

# --- Configuración---
INPUT_PATH = "/mnt/data/video_game_reviews.xlsx"
OUT_DIR = "/mnt/data/preparacion_datos"
TOPK_CATEGORIES = 10      # cuántas categorías conservar por columna categórica
MAX_FEATURES_SELECT = 30  # máximo de características a mantener tras SelectKBest
PCA_THRESHOLD = 40        # aplicar PCA si #features > PCA_THRESHOLD
RANDOM_STATE = 42
# ---------------------------------------------

os.makedirs(OUT_DIR, exist_ok=True)

# Cargar
print("Cargando:", INPUT_PATH)
df = pd.read_excel(INPUT_PATH)
print("Shape original:", df.shape)

# Detectar target (busca nombres comunes; si no encuentra, usa primera numérica no-ID)
possible_targets = ['score','rating','user_score','metacritic','user rating','user_rating','rating']
found_targets = [c for c in df.columns if c.lower() in possible_targets]
if found_targets:
    target_col = found_targets[0]
else:
    numeric_cols = df.select_dtypes(include=[np.number]).columns.tolist()
    numeric_cols = [c for c in numeric_cols if 'id' not in c.lower()]
    target_col = numeric_cols[0] if numeric_cols else df.columns[-1]
print("Target elegido:", target_col)

# Separar X/y
X = df.drop(columns=[target_col]).copy()
y = df[target_col].copy()

# Quitar columnas que parecen identificadores o textos únicos
to_drop = [c for c in X.columns if (X[c].dtype==object and X[c].nunique()==X.shape[0]) or c.lower().endswith('id')]
if to_drop:
    print("Columnas a eliminar (IDs/únicas):", to_drop)
X.drop(columns=to_drop, inplace=True, errors='ignore')

# Imputación
num_cols = X.select_dtypes(include=[np.number]).columns.tolist()
cat_cols = X.select_dtypes(include=['object','category','bool']).columns.tolist()

num_imp = SimpleImputer(strategy='median')
cat_imp = SimpleImputer(strategy='most_frequent')
if num_cols:
    X[num_cols] = num_imp.fit_transform(X[num_cols])
if cat_cols:
    X[cat_cols] = cat_imp.fit_transform(X[cat_cols])

# Encoding categóricas: conservar top-k por columna, agrupar resto en '_OTHER_'
for c in cat_cols:
    if c in X.columns:
        topk = X[c].value_counts().nlargest(TOPK_CATEGORIES).index
        X[c] = X[c].where(X[c].isin(topk), other='_OTHER_')

# One-hot encode (drop='first' para evitar colinealidad)
onehot_cols = [c for c in cat_cols if c in X.columns]
if onehot_cols:
    ohe = OneHotEncoder(sparse=False, drop='first', handle_unknown='ignore')
    ohe_arr = ohe.fit_transform(X[onehot_cols].astype(str))
    ohe_cols = ohe.get_feature_names_out(onehot_cols)
    df_ohe = pd.DataFrame(ohe_arr, columns=ohe_cols, index=X.index)
    X = pd.concat([X.drop(columns=onehot_cols), df_ohe], axis=1)

# Manejo de outliers (capping por IQR)
for c in num_cols:
    if c in X.columns:
        q1 = X[c].quantile(0.25)
        q3 = X[c].quantile(0.75)
        iqr = q3 - q1
        X[c] = X[c].clip(q1 - 1.5*iqr, q3 + 1.5*iqr)

# Escalado
numeric_now = X.select_dtypes(include=[np.number]).columns.tolist()
if numeric_now:
    scaler = StandardScaler()
    X[numeric_now] = scaler.fit_transform(X[numeric_now])

# Selección de características rápida y estable: SelectKBest (f_regression / f_classif)
is_regression = pd.api.types.is_numeric_dtype(y)
if is_regression:
    selector = SelectKBest(score_func=f_regression, k=min(MAX_FEATURES_SELECT, X.shape[1]))
else:
    selector = SelectKBest(score_func=f_classif, k=min(MAX_FEATURES_SELECT, X.shape[1]))
try:
    selector.fit(X.fillna(0), (y.fillna(y.median()) if is_regression else LabelEncoder().fit_transform(y.astype(str))))
    mask = selector.get_support()
    selected_features = X.columns[mask].tolist()
    if not selected_features:
        # fallback: top variance
        selected_features = X.var().sort_values(ascending=False).head(min(MAX_FEATURES_SELECT, X.shape[1])).index.tolist()
except Exception as e:
    print("SelectKBest falló:", e)
    selected_features = X.var().sort_values(ascending=False).head(min(MAX_FEATURES_SELECT, X.shape[1])).index.tolist()

print("Número de características seleccionadas:", len(selected_features))
X_selected = X[selected_features].copy()

# PCA opcional si muchas features
if X_selected.shape[1] > PCA_THRESHOLD:
    pca = PCA(n_components=0.95, svd_solver='full')
    X_pca = pca.fit_transform(X_selected)
    X_final = pd.DataFrame(X_pca, index=X_selected.index, columns=[f'PC{i+1}' for i in range(X_pca.shape[1])])
    print("PCA aplicado: componentes ->", X_final.shape[1])
else:
    X_final = X_selected.copy()

# Dataset final
final_df = pd.concat([X_final, pd.Series(y, name=target_col)], axis=1)
print("Final dataframe shape:", final_df.shape)

# Splits: Train/Test 80/20, luego Train2/Validation 80/20
train_df, test_df = train_test_split(final_df, test_size=0.2, random_state=RANDOM_STATE, stratify=None if is_regression else LabelEncoder().fit_transform(final_df[target_col].astype(str)))
train2_df, val_df = train_test_split(train_df, test_size=0.2, random_state=RANDOM_STATE, stratify=None if is_regression else LabelEncoder().fit_transform(train_df[target_col].astype(str)))

# Guardar 6 CSVs (TrainX, TrainY, ValidationX, ValidationY, TestX, TestY)
TrainX = train2_df.drop(columns=[target_col]); TrainY = train2_df[[target_col]]
ValX = val_df.drop(columns=[target_col]); ValY = val_df[[target_col]]
TestX = test_df.drop(columns=[target_col]); TestY = test_df[[target_col]]

TrainX.to_csv(os.path.join(OUT_DIR, "TrainX.csv"), index=False)
TrainY.to_csv(os.path.join(OUT_DIR, "TrainY.csv"), index=False)
ValX.to_csv(os.path.join(OUT_DIR, "ValidationX.csv"), index=False)
ValY.to_csv(os.path.join(OUT_DIR, "ValidationY.csv"), index=False)
TestX.to_csv(os.path.join(OUT_DIR, "TestX.csv"), index=False)
TestY.to_csv(os.path.join(OUT_DIR, "TestY.csv"), index=False)

print("CSV guardados en:", OUT_DIR)
print(sorted(os.listdir(OUT_DIR)))

print("Proceso completado. Revise los CSVs y ajuste parámetros (TOPK_CATEGORIES, MAX_FEATURES_SELECT, PCA_THRESHOLD) si desea más/menos dimension
